		{
			exch dup/ftdt edf begin 
				wdict begin
					/chr edf
					/chrst wrk1 dup 0 chr put def 
					ft2 0 get null eq
					{
						ft1 dup length 2 add dict begin
						{1 index/FID ne 2 index /UniqueID ne and{def}{pop pop}ifelse}forall
						/PaintType 2 def
						/StrokeWidth .24 1000 mul ftSize div dup 12 lt{pop 12}if def
						currentdict end
						/q exch definefont
						ft2 exch 0 exch put
					}if
					ftdt/proc2 get exec 
				end 
			end
		}def
		
		end
	 
		tempFT
				
	}ifelse
	3 index exch
	definefont exch pop
